<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <StartupObject>ZenQOffice.Tests.DocxInteropTests</StartupObject>
    <Nullable>disable</Nullable>
    <OutputPath>bin_docx\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416;CS1685;CS0168;CS0219;CS0414;CS0649;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenQOffice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DocxInteropTests.cs" />
  </ItemGroup>
</Project>
