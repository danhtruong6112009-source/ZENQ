<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/PdfSaveLoadTests/</OutputPath>
    <IntermediateOutputPath>obj/PdfSaveLoadTests/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ZenQOffice.csproj" />
    <Reference Include="PdfSharp"><HintPath>../PdfSharp.dll</HintPath></Reference>
    <Reference Include="PdfiumViewer"><HintPath>../PdfiumViewer.dll</HintPath></Reference>
    <Compile Include="PdfSaveLoadTests.cs" />
  </ItemGroup>
</Project>
