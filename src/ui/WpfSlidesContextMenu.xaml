<Window x:Class="GenOffice.UI.WpfSlidesContextMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WpfSlidesContextMenu" Height="Auto" Width="Auto"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated">
    
    <Window.Resources>
        <Style x:Key="MiniBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5F3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CtxMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="5,2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.Effect>
            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="15" ShadowDepth="5"/>
        </Grid.Effect>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Mini Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D2D2D2" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5" Padding="5" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="100" Height="24" Margin="0,0,5,0" SelectedIndex="0">
                    <ComboBoxItem>Arial</ComboBoxItem>
                    <ComboBoxItem>Calibri</ComboBoxItem>
                    <ComboBoxItem>Segoe UI</ComboBoxItem>
                    <ComboBoxItem>Times New Roman</ComboBoxItem>
                </ComboBox>
                <ComboBox Width="45" Height="24" Margin="0,0,5,0" SelectedIndex="2">
                    <ComboBoxItem>12</ComboBoxItem>
                    <ComboBoxItem>14</ComboBoxItem>
                    <ComboBoxItem>18</ComboBoxItem>
                    <ComboBoxItem>24</ComboBoxItem>
                    <ComboBoxItem>36</ComboBoxItem>
                </ComboBox>
                <Button Style="{StaticResource MiniBtnStyle}" FontWeight="Bold" ToolTip="In đậm" Click="BtnBold_Click">B</Button>
                <Button Style="{StaticResource MiniBtnStyle}" FontStyle="Italic" ToolTip="In nghiêng" Click="BtnItalic_Click">I</Button>
                <Button Style="{StaticResource MiniBtnStyle}" ToolTip="Gạch chân" Click="BtnUnderline_Click">
                    <TextBlock TextDecorations="Underline">U</TextBlock>
                </Button>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,2"/>
                <Button Style="{StaticResource MiniBtnStyle}" ToolTip="Màu chữ" Click="BtnColor_Click">
                    <StackPanel>
                        <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                        <Rectangle Fill="Red" Height="4" Width="12" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <!-- Context Menu List -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D2D2D2" BorderThickness="1" CornerRadius="4" Padding="2" HorizontalAlignment="Left" MinWidth="220">
            <StackPanel>
                <MenuItem Header="Cắt (Cut)" Style="{StaticResource CtxMenuItemStyle}" Click="MenuCut_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="✂"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sao chép (Copy)" Style="{StaticResource CtxMenuItemStyle}" Click="MenuCopy_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📄"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Dán (Paste)" Style="{StaticResource CtxMenuItemStyle}" Click="MenuPaste_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📋"/>
                    </MenuItem.Icon>
                </MenuItem>
                
                <Rectangle Height="1" Fill="#E0E0E0" Margin="30,2,2,2"/>
                
                <MenuItem Header="Lên trên cùng" Style="{StaticResource CtxMenuItemStyle}" Click="MenuBringFront_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⏫"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Lên 1 lớp" Style="{StaticResource CtxMenuItemStyle}" Click="MenuBringForward_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔼"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Xuống dưới cùng" Style="{StaticResource CtxMenuItemStyle}" Click="MenuSendBack_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⏬"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Xuống 1 lớp" Style="{StaticResource CtxMenuItemStyle}" Click="MenuSendBackward_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔽"/>
                    </MenuItem.Icon>
                </MenuItem>
                
                <Rectangle Height="1" Fill="#E0E0E0" Margin="30,2,2,2"/>
                
                <MenuItem Header="Nhóm (Group)" Style="{StaticResource CtxMenuItemStyle}" Click="MenuGroup_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔗"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Bỏ nhóm (Ungroup)" Style="{StaticResource CtxMenuItemStyle}" Click="MenuUngroup_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔗"/>
                    </MenuItem.Icon>
                </MenuItem>
                
                <Rectangle Height="1" Fill="#E0E0E0" Margin="30,2,2,2"/>
                
                <MenuItem Header="Định dạng hình (Format Shape)..." Style="{StaticResource CtxMenuItemStyle}" Click="MenuFormat_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🖌"/>
                    </MenuItem.Icon>
                </MenuItem>
            </StackPanel>
        </Border>
    </Grid>
</Window>
