<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>ZenQOffice</AssemblyName>
    <ApplicationIcon>ZenQOffice.ico</ApplicationIcon>
    <StartupObject>ZenQOffice.Program</StartupObject>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416;CS1685;CS0168;CS0219;CS0414;CS0649;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;WFO1000;WFO5001;WFO5002</NoWarn>
    <WarningsNotAsErrors>WFO1000;WFO5001;WFO5002</WarningsNotAsErrors>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  
    <Reference Include="Vortice.Direct2D1"><HintPath>Vortice.Direct2D1.dll</HintPath></Reference>
    <Reference Include="Vortice.Mathematics"><HintPath>Vortice.Mathematics.dll</HintPath></Reference>
    <Reference Include="Vortice.DXGI"><HintPath>Vortice.DXGI.dll</HintPath></Reference>
    <Reference Include="Vortice.DirectX"><HintPath>Vortice.DirectX.dll</HintPath></Reference>

  
    <Reference Include="SharpGen.Runtime"><HintPath>SharpGen.Runtime.dll</HintPath></Reference>
    <Reference Include="SharpGen.Runtime.COM"><HintPath>SharpGen.Runtime.COM.dll</HintPath></Reference>

  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ZENQOFFICE.png">
      <LogicalName>app_logo.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ZenQOffice.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon\writer.png">
      <LogicalName>icon_writer.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon\calc.png">
      <LogicalName>icon_calc.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon\present.png">
      <LogicalName>icon_present.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon\pdf.png">
      <LogicalName>icon_pdf.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon\vector.png">
      <LogicalName>icon_vector.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon\banner.png">
      <LogicalName>banner.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DocumentFormat.OpenXml">
      <HintPath>DocumentFormat.OpenXml.dll</HintPath>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml.Framework">
      <HintPath>DocumentFormat.OpenXml.Framework.dll</HintPath>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml.Features">
      <HintPath>DocumentFormat.OpenXml.Features.dll</HintPath>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml.Linq">
      <HintPath>DocumentFormat.OpenXml.Linq.dll</HintPath>
    </Reference>
    <Reference Include="PdfiumViewer">
      <HintPath>PdfiumViewer.dll</HintPath>
    </Reference>
    <Reference Include="PdfSharp">
      <HintPath>PdfSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyToRoot" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)ZenQOffice.exe" DestinationFolder="$(MSBuildProjectDirectory)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" Condition="Exists('$(TargetDir)ZenQOffice.exe')" />
    <Copy SourceFiles="$(TargetDir)ZenQOffice.dll" DestinationFolder="$(MSBuildProjectDirectory)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
    <Copy SourceFiles="$(TargetDir)ZenQOffice.runtimeconfig.json" DestinationFolder="$(MSBuildProjectDirectory)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" Condition="Exists('$(TargetDir)ZenQOffice.runtimeconfig.json')" />
    <Copy SourceFiles="$(TargetDir)ZenQOffice.deps.json" DestinationFolder="$(MSBuildProjectDirectory)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" Condition="Exists('$(TargetDir)ZenQOffice.deps.json')" />
    <Copy SourceFiles="$(TargetDir)ZenQOffice.pdb" DestinationFolder="$(MSBuildProjectDirectory)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" Condition="Exists('$(TargetDir)ZenQOffice.pdb')" />
  </Target>

</Project>

